{
  "name": "commit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:nuke": "docker compose down -v",
    "db:generate": "pnpm --filter @ledger/api db:generate",
    "db:migrate": "pnpm --filter @ledger/api db:migrate",
    "dev": "pnpm --filter @ledger/api dev",
    "test": "node --no-warnings --test 'commit/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.commit.json && pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck:commit": "tsc -p tsconfig.commit.json",
    "calibration:start": "PORT=${PORT:-8080} node --no-warnings calibration/pocketful-stage-1/src/server.ts",
    "verify": "node --no-warnings commit/self-audit.ts",
    "verify:gate": "node --no-warnings commit/verify.ts --plan calibration/verification/plan.json --skip mutation --out evidence/calibration/stage-1/gate-$(date -u +%Y%m%dT%H%M%SZ)",
    "verify:contract": "node --no-warnings calibration/verification/contract.ts",
    "verify:reference": "node --no-warnings commit/campaign.ts --module calibration/verification/reference.campaign.ts",
    "verify:adversarial": "node --no-warnings calibration/verification/adversarial.ts",
    "verify:mutation": "node --no-warnings commit/mutate.ts --target calibration/pocketful-stage-1 --start 'node --no-warnings src/server.ts' --check 'calibration/verification/kill-suite.sh {url}' --exclude calibration/verification/equivalents.json --jobs 6 --timeout 180000 --out evidence/calibration/stage-1/mutation-$(date -u +%Y%m%dT%H%M%SZ)",
    "factory:bootstrap": "commit/bootstrap.sh",
    "test:upstream": "pnpm -r test",
    "verify:full": "node --no-warnings commit/self-audit.ts --full",
    "verify:calibration": "node --no-warnings commit/verify.ts --plan calibration/verification/plan.json --out evidence/calibration/stage-1/run-$(date -u +%Y%m%dT%H%M%SZ)",
    "factory": "node --no-warnings commit/cli.ts",
    "doctor": "node --no-warnings commit/cli.ts doctor"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.19.0",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.8.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0"
  }
}
