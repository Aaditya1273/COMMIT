{
  "stage": "calibration / pocketful stage 1",
  "target": "calibration/pocketful-stage-1",
  "specification": "dark-factory-wearedevs/pocketful/spec/stage-1.md (kickoff commit 803560d)",
  "service": { "start": "node --no-warnings src/server.ts", "health": "/health" },
  "steps": [
    { "id": "typecheck", "kind": "required", "blocking": true, "cmd": "npx tsc -p tsconfig.commit.json" },
    { "id": "lint", "kind": "required", "blocking": true, "cmd": "npx eslint commit calibration" },
    { "id": "startup", "kind": "startup", "blocking": true, "needsService": true, "requirements": ["§3.1", "§3.2"],
      "cmd": "curl -sf {url}/health" },
    { "id": "shipped-checks", "kind": "required", "blocking": true, "needsService": true,
      "requirements": ["stage-1 sample and shipped suites"],
      "environment": "test -x {kickoff}/.venv/bin/python",
      "cmd": "cd {kickoff} && .venv/bin/python -m pytest pocketful/test/stage_1 -p harness.plugin --base-url {url} -q -p no:cacheprovider" },
    { "id": "overshoot-probe", "kind": "required", "blocking": true, "needsService": true,
      "requirements": ["a stage-1 folder must not pass the stage-2 suite"],
      "environment": "test -x {kickoff}/.venv/bin/python",
      "cmd": "cd {kickoff} && ! .venv/bin/python -m pytest pocketful/test/stage_2/test_sample.py -p harness.plugin --base-url {url} -q -p no:cacheprovider" },
    { "id": "contract", "kind": "contract", "blocking": true, "needsService": true, "report": "contract/contract-report.json",
      "requirements": ["§3", "§4", "§5", "§6", "§7", "§8", "§9", "§10", "§11"],
      "cmd": "node --no-warnings calibration/verification/contract.ts --base-url {url} --out {out}/contract" },
    { "id": "reference-481927", "kind": "reference-model", "blocking": true, "needsService": true, "report": "reference-481927/reference-report.json",
      "requirements": ["§1 invariants", "§7", "§8", "§9", "§11"],
      "cmd": "node --no-warnings commit/campaign.ts --module calibration/verification/reference.campaign.ts --base-url {url} --seed 481927 --operations 1000 --out {out}/reference-481927" },
    { "id": "reference-7", "kind": "reference-model", "blocking": true, "needsService": true, "report": "reference-7/reference-report.json",
      "requirements": ["§1 invariants", "§7", "§8", "§9", "§11"],
      "cmd": "node --no-warnings commit/campaign.ts --module calibration/verification/reference.campaign.ts --base-url {url} --seed 7 --operations 1000 --out {out}/reference-7" },
    { "id": "reference-90210", "kind": "reference-model", "blocking": true, "needsService": true, "report": "reference-90210/reference-report.json",
      "requirements": ["§1 invariants", "§7", "§8", "§9", "§11"],
      "cmd": "node --no-warnings commit/campaign.ts --module calibration/verification/reference.campaign.ts --base-url {url} --seed 90210 --operations 1000 --out {out}/reference-90210" },
    { "id": "adversarial", "kind": "adversarial", "blocking": true, "needsService": true, "report": "adversarial/adversarial-report.json",
      "requirements": ["§1 invariants", "§2 concurrency", "§7", "§11"],
      "cmd": "node --no-warnings calibration/verification/adversarial.ts --base-url {url} --seed 20261001 --workers 50 --rounds 5 --out {out}/adversarial" },
    { "id": "mutation", "kind": "mutation", "blocking": true, "report": "mutation/mutation-report.json", "timeoutMs": 7200000,
      "environment": "test -x {kickoff}/.venv/bin/python",
      "cmd": "node --no-warnings commit/mutate.ts --target calibration/pocketful-stage-1 --start 'node --no-warnings src/server.ts' --check 'calibration/verification/kill-suite.sh {url}' --exclude calibration/verification/equivalents.json --jobs 6 --timeout 180000 --out {out}/mutation" },
    { "id": "clean-build", "kind": "build", "blocking": true, "environment": "docker info",
      "cmd": "docker build --no-cache -t commit-calibration-stage-1 calibration/pocketful-stage-1" },
    { "id": "offline-isolated", "kind": "offline", "blocking": true, "environment": "docker info",
      "requirements": ["§2 no outbound network at run time, 2 vCPU, 2 GiB"],
      "cmd": "PYTHONPATH={kickoff} {kickoff}/.venv/bin/python -m harness run --track pocketful --build calibration/pocketful-stage-1 --mode isolated --stage 1 --out {out}/isolated" }
  ]
}
